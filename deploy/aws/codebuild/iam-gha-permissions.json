{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartAndObserveCliCodeBuild",
      "Effect": "Allow",
      "Action": [
        "codebuild:StartBuild",
        "codebuild:BatchGetBuilds"
      ],
      "Resource": [
        "arn:aws:codebuild:REGION:ACCOUNT_ID:project/cortex-cli-gha-x64",
        "arn:aws:codebuild:REGION:ACCOUNT_ID:project/cortex-cli-gha-arm64",
        "arn:aws:codebuild:REGION:ACCOUNT_ID:project/cortex-cli-gha-x64-pr",
        "arn:aws:codebuild:REGION:ACCOUNT_ID:project/cortex-cli-gha-arm64-pr"
      ]
    },
    {
      "Sid": "StreamCliCodeBuildLogs",
      "Effect": "Allow",
      "Action": [
        "logs:GetLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/codebuild/cortex-cli-gha-x64:*",
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/codebuild/cortex-cli-gha-arm64:*",
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/codebuild/cortex-cli-gha-x64-pr:*",
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/codebuild/cortex-cli-gha-arm64-pr:*"
      ]
    }
  ]
}
